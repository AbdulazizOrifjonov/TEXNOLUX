# NEXT NOUT / NSB — Environment Variables
# Supabase & Vercel Configuration

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Standalone backend URL (leave empty if using direct Supabase)
# VITE_API_URL=http://localhost:5000/api
